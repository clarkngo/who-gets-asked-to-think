# Copy to .env (which is gitignored) and fill in. Never paste keys into chat or commit them.
ANTHROPIC_API_KEY=
# Only needed if your key isn't scoped to a workspace (Console → Settings → Workspaces):
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
GEMINI_BILLING=free_tier   # or paid; recorded with every Gemini call
OLLAMA_HOST=http://localhost:11434
